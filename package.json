{
  "name": "scout",
  "private": true,
  "version": "0.1.0",
  "description": "Tiered OSINT investigation platform \u2014 a launcher, not an aggregator.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "./scripts/start.sh",
    "stop": "./scripts/stop.sh",
    "restart": "./scripts/stop.sh && ./scripts/start.sh",
    "autostart": "./scripts/install-autostart.sh",
    "demo": "pnpm --filter @scout/web exec node demo/build.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @scout/db exec prisma generate",
    "db:migrate": "pnpm --filter @scout/db exec prisma migrate dev",
    "db:deploy": "pnpm --filter @scout/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @scout/db run seed",
    "db:studio": "pnpm --filter @scout/db exec prisma studio",
    "db:operator": "pnpm --filter @scout/db run operator",
    "bootstrap:v2": "./scripts/bootstrap-v2.sh",
    "test:services": "for s in resolution recognition; do (cd services/$s && uv run --quiet pytest -q) || exit 1; done",
    "eval:resolution": "cd services/resolution && uv run --quiet python -m eval.evaluate --check",
    "graph:check": "pnpm --filter @scout/db run graph:check",
    "faa:sync": "pnpm --filter @scout/db run faa:sync",
    "voters:import": "pnpm --filter @scout/db run voters:import"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
