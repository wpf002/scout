// Scout — persistence layer (Phase 1).
//
// The shape here encodes the platform's invariants:
//   - Scope hangs off a Case, never off a request parameter.
//   - A Case cannot exist without an authorizationRef.
//   - Every scoped query attempt writes a QueryLog row, allowed or denied.
//   - Every Finding carries the source + query + case + time that produced it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStatus {
  ACTIVE
  CLOSED
}

/// An authenticated operator. Every audit row is attributed to one.
///
/// Tokens are stored as SHA-256 digests, not reversible values. A fast hash is
/// the right choice here and a slow one would not help: these are 256-bit
/// random tokens, not passwords, so there is no low-entropy guess to make
/// expensive.
model Operator {
  id        String   @id @default(cuid())
  name      String   @unique
  tokenHash String   @unique
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime?

  @@index([active])
}

enum ScopeKind {
  DOMAIN
  IDENTIFIER
}

enum SubjectKind {
  DOMAIN
  IP
  EMAIL
  USERNAME
  PERSON
  COMPANY
  HASH
  KEYWORD
}

enum Tier {
  DATASETS
  INFRA
  EXPOSURE
  PEOPLE
  ONION
  UTILS
}

/// PLAN — the planner considered this source for this subject.
/// EXECUTE — Scout actually attempted the upstream call.
enum QueryPhase {
  PLAN
  EXECUTE
}

enum QueryOutcome {
  ALLOWED
  DENIED
  INERT
  ERROR
}

/// An investigation. Owns its own authorization scope, which is the unit that
/// matters: permission is granted per engagement, not per Scout instance.
model Case {
  id     String     @id @default(cuid())
  name   String
  status CaseStatus @default(ACTIVE)

  /// Reference to the engagement or permission that authorizes this work.
  /// Required at creation — a case with no authorization can never run a
  /// scoped source, so there is no legitimate state where this is absent.
  authorizationRef String

  notes String?

  /// Soft delete. Archived cases drop out of the default listing but keep
  /// their audit trail — which is why this is a timestamp rather than a row
  /// deletion. The audit triggers would refuse the delete anyway.
  archivedAt DateTime?
  /// When the investigative content (findings, subjects) was purged. The case
  /// shell and its audit trail survive: minimizing retained data must not mean
  /// destroying the record of what was done.
  purgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String   @default("local")

  scopeEntries    ScopeEntry[]
  subjects        Subject[]
  findings        Finding[]
  queryLogs       QueryLog[]
  sourceSettings  CaseSource[]
  entityMerges    EntityMerge[]
  mergeDismissals MergeDismissal[]
  monitors        Monitor[]

  /// v2. Optional: a case that never collects, resolves or reads the v2
  /// graph works exactly as it did without one. A case that does needs one,
  /// because `authorizationRef` is a string and the v2 gate needs a window,
  /// an issuer and a permission list.
  authorizationId String?
  authorization   Authorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)
  observations    Observation[]

  @@index([status, createdAt])
  @@index([archivedAt])
  @@index([authorizationId])
}

/// One authorized target. The gate matches subjects against these rows and
/// nothing else. Adding one is an audited act (see AuditEvent).
model ScopeEntry {
  id     String    @id @default(cuid())
  caseId String
  case   Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind   ScopeKind
  /// Stored as entered; normalized at match time by @scout/scope.
  value  String
  note   String?

  addedBy   String   @default("local")
  createdAt DateTime @default(now())

  @@unique([caseId, kind, value])
  @@index([caseId])
}

/// A thing being investigated within a case.
model Subject {
  id     String      @id @default(cuid())
  caseId String
  case   Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind   SubjectKind
  value  String
  label  String?

  createdAt DateTime @default(now())

  findings Finding[]

  @@unique([caseId, kind, value])
  @@index([caseId])
}

/// A saved observation. Provenance is not optional decoration — sourceId,
/// queryTerm, caseId and observedAt are all required, so an orphan finding
/// cannot be written.
model Finding {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  sourceId String
  tier     Tier

  title   String
  summary String?
  /// Normalized payload from the adapter. BigInt counts are stored as strings
  /// here because JSON has no integer type wide enough for them.
  data    Json    @default("{}")

  // ── provenance ──
  queryTerm  String
  queryKind  SubjectKind
  observedAt DateTime
  /// The audit row this finding came out of, when it came from a Scout call.
  /// Null for findings the investigator saved by hand from a deeplink.
  queryLogId String?
  queryLog   QueryLog? @relation(fields: [queryLogId], references: [id], onDelete: SetNull)

  savedBy   String   @default("local")
  createdAt DateTime @default(now())

  @@index([caseId, sourceId])
  @@index([caseId, createdAt])
}

/// The accountability layer. One row per scoped query attempt — planned or
/// executed, allowed or denied.
///
/// These rows are immutable: a database trigger (see migration
/// `20260808163341_audit_immutable`) rejects UPDATE and DELETE. An audit log
/// that the application can quietly rewrite is not an audit log.
model QueryLog {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  sourceId      String
  tier          Tier
  requiresScope Boolean

  phase   QueryPhase
  outcome QueryOutcome
  /// Why this outcome, as a stable machine-readable string. For DENIED these
  /// are exactly the `DenyReason` values exported by @scout/scope
  /// (`out-of-scope`, `scope-empty`, `case-required`, …); for INERT they
  /// describe what was missing (`missing-key`, `adapter-not-built`).
  reason String?

  subjectKind  SubjectKind
  /// The term as submitted. Recorded so a denial is reviewable after the fact.
  subjectValue String

  /// Snapshot of the case's authorization at the moment of the query — kept
  /// verbatim so later edits to the case cannot rewrite history.
  authorizationRef String
  operator         String @default("local")

  /// Which scope entry authorized this query, snapshotted rather than joined.
  /// Deliberately NOT a foreign key: removing a scope entry later must not
  /// reach back and rewrite the rows it authorized — and with the immutability
  /// trigger in place, a SetNull cascade would simply fail. The audit row
  /// records what scope said at query time, permanently.
  matchedScopeEntryId String?
  matchedScopeValue   String?

  /// Upstream failure detail when outcome is ERROR. Never contains a key.
  errorMessage String?
  durationMs   Int?

  createdAt DateTime @default(now())

  findings Finding[]

  @@index([caseId, createdAt])
  @@index([caseId, sourceId])
  @@index([outcome, createdAt])
}

/// Per-case source toggles. The registry in @scout/sources stays the source of
/// truth for what a source *is*; this only records whether a case wants it.
model CaseSource {
  id       String  @id @default(cuid())
  caseId   String
  case     Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceId String
  enabled  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, sourceId])
  @@index([caseId])
}

/// Case-lifecycle events that are not queries: scope added or removed, case
/// opened or closed. Scope changes are authorization changes, so they belong
/// in the record next to the queries they enable.
model AuditEvent {
  id     String  @id @default(cuid())
  caseId String?

  action  String
  detail  Json    @default("{}")
  actor   String  @default("local")

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

/// An operator-confirmed entity merge.
///
/// The graph itself is NOT stored — it is recomputed from findings on every
/// read, so it can never drift from the evidence. What is stored is the
/// judgement: which near-matching entities a human decided were the same
/// thing. That decision must survive a rebuild; the graph need not.
model EntityMerge {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// The entity key that was merged away, and the one it merged into.
  losingKey  String
  winningKey String

  /// Why. A merge is an assertion that two records describe one thing, and a
  /// year later the only way to know why is if someone wrote it down.
  reason      String
  confirmedBy String   @default("local")
  createdAt   DateTime @default(now())

  @@unique([caseId, losingKey])
  @@index([caseId])
}

/// A merge suggestion an operator rejected, so it stops being offered.
model MergeDismissal {
  id           String @id @default(cuid())
  caseId       String
  case         Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  suggestionId String

  dismissedBy String   @default("local")
  createdAt   DateTime @default(now())

  @@unique([caseId, suggestionId])
  @@index([caseId])
}

/// A standing watch on a subject.
///
/// Continuous monitoring is the capability every comparable platform leads
/// with, and Scout was pull-only without it. It carries one hard restriction
/// that those platforms do not: **a monitor may only include sources that are
/// ungated for its subject kind.**
///
/// The reason is locked invariant 2. Person-facing sources run "one confirmed
/// action at a time"; a recurring automated re-run is the precise opposite of
/// that. You can watch a domain's infrastructure change. You cannot put a
/// person under standing automated surveillance — which is what a scope gate
/// and a per-action confirmation exist to prevent.
model Monitor {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  name         String
  subjectKind  SubjectKind
  subjectValue String
  /// Validated at creation: every entry must be ungated for `subjectKind`.
  sourceIds    String[]

  /// A geofence: `{south, west, north, east}`, watched instead of an
  /// indicator. Exactly one of `subjectValue` and `area` is meaningful, which
  /// is enforced at creation — a monitor that watched both would be two
  /// monitors wearing one name.
  ///
  /// Geofences watch places and platforms. They never watch people: the live
  /// layers a geofence can name carry aircraft, vessels, fires and incidents,
  /// and the person-facing tiers are unreachable from here by construction.
  area      Json?
  /// Live layer ids this geofence watches. Empty for an indicator monitor.
  layerIds  String[] @default([])

  intervalMinutes Int     @default(1440)
  enabled         Boolean @default(true)

  lastRunAt DateTime?
  createdBy String    @default("local")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  runs    MonitorRun[]
  changes MonitorChange[]

  @@index([caseId])
  @@index([enabled, lastRunAt])
}

/// One execution of a monitor, with the observation set it saw.
model MonitorRun {
  id        String  @id @default(cuid())
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  caseId    String

  startedAt  DateTime @default(now())
  durationMs Int?
  /// Observation keys seen this run. Diffing two of these is what produces
  /// changes — the raw payloads live in the audit-logged query results.
  snapshot   Json     @default("[]")
  observationCount Int @default(0)
  changeCount      Int @default(0)
  errorMessage     String?

  changes MonitorChange[]

  @@index([monitorId, startedAt])
}

enum ChangeType {
  ADDED
  REMOVED
}

/// Something that changed between two runs. This is the alert.
model MonitorChange {
  id        String     @id @default(cuid())
  monitorId String
  monitor   Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  runId     String
  run       MonitorRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId    String

  changeType     ChangeType
  /// `subdomain` | `host` | `cert` | `dataset-hit` | `sanction-match`
  observationKind String
  observationKey  String
  detail          Json    @default("{}")
  sourceIds       String[]

  /// Acknowledging is how an alert stops being noise. There is no unique
  /// constraint here on purpose: a host that disappears and comes back is two
  /// events, not one, and collapsing them would hide the flap. Duplicates
  /// within a single run are already impossible — the run diffs a keyed set.
  acknowledgedAt DateTime?
  acknowledgedBy String?

  createdAt DateTime @default(now())

  @@index([caseId, acknowledgedAt])
  @@index([monitorId, createdAt])
}


// ═══════════════════════════════════════════════════════════════════════════
// v2 — fusion, resolution, the temporal graph, gallery-restricted biometrics
//
// Additive. Nothing above changed shape. Names avoid the two collisions the
// spec would have created: the connector table is `CollectionSource` because
// `Source` is the @scout/sources registry type, and read audit is `AccessLog`
// because `AuditEvent` already exists with a different shape.
//
// Scores and confidence are integer basis points (0–10000). Never floats.
// ═══════════════════════════════════════════════════════════════════════════

enum SourceClass {
  OWNED
  LICENSED
  PUBLIC_RECORD
  OPEN_WEB
  BROKER
  SENSOR
  SATELLITE
  FIRST_PARTY
}

enum ActionClass {
  COLLECT
  RESOLVE
  READ_GRAPH
  BIOMETRIC_COMPARE
  PROPOSE
  APPROVE_CONSEQUENTIAL
}

/// The v2 authorization object. `Case.authorizationRef` names it; this row
/// says who issued it, what it permits, and when it stops. A revoked row is
/// kept, never deleted: the record that something was authorized and then
/// wasn't is part of the audit trail.
model Authorization {
  id        String @id @default(cuid())
  reference String
  issuedBy  String
  /// `{ scope: ScopeEntry[], entityKinds: string[] }`, parsed by @scout/scope.
  boundary      Json
  sourceClasses SourceClass[]
  actionClasses ActionClass[]
  validFrom     DateTime
  validUntil    DateTime
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?
  createdAt     DateTime @default(now())
  createdBy     String   @default("local")

  cases          Case[]
  observations   Observation[]
  edges          EntityEdge[]
  resolutionRuns ResolutionRun[]
  comparisons    BiometricComparison[]

  @@index([reference])
  @@index([validUntil, revokedAt])
}

/// A v2 collector, as registered. The code declaration in packages/fusion is
/// the source of truth for what it does; this row records what it is and
/// under what terms, so an observation can always be traced to a licence.
model CollectionSource {
  id                      String      @id
  name                    String
  class                   SourceClass
  /// Required. A collector that cannot state its terms does not register.
  licensingTerms          String
  tosUrl                  String?
  refreshCadenceSeconds   Int
  spatialResolutionMeters Int?
  temporalLagSeconds      Int?
  enabled                 Boolean     @default(true)
  /// Env var name. Never the credential.
  credentialsRef          String?
  createdAt               DateTime    @default(now())

  observations Observation[]
}

/// The atomic unit. Immutable once written (UPDATE is rejected by trigger;
/// DELETE is left to retention, which minimizes what was collected about
/// people while keeping the record of what was done).
///
/// Four NOT NULL provenance columns. An observation without them is a write
/// failure in @scout/fusion before it reaches here, and here if it somehow
/// does.
model Observation {
  id              String           @id @default(cuid())
  sourceId        String
  source          CollectionSource @relation(fields: [sourceId], references: [id])
  authorizationId String
  authorization   Authorization    @relation(fields: [authorizationId], references: [id])
  caseId          String?
  case            Case?            @relation(fields: [caseId], references: [id], onDelete: SetNull)

  /// When Scout received it.
  collectedAt DateTime
  /// When it happened, as the source states it.
  observedAt  DateTime

  rawPayload        Json
  normalizedPayload Json
  /// sha256 of the canonical normalized payload. Dedupe key per source and
  /// per authorization: the same public fact collected under two
  /// authorizations is two rows, because each row says which authorization
  /// collected it and a row can only say one.
  contentHash       String
  /// PostGIS. Null when the observation has no position. Written through raw
  /// SQL; the Prisma client omits Unsupported fields.
  geom              Unsupported("geography(Point,4326)")?
  confidenceBp      Int?
  indeterminate     Boolean @default(false)
  /// What kind of entity this observation is about, as the collector says.
  /// Resolution runs per kind; an observation with no kind is not resolved.
  entityKind        FusionEntityKind?
  createdAt         DateTime @default(now())

  identifiers Identifier[]
  memberships EntityMember[]

  @@unique([sourceId, authorizationId, contentHash])
  @@index([authorizationId, entityKind])
  @@index([authorizationId, observedAt])
  @@index([observedAt])
  @@index([caseId])
}

enum IdentifierKind {
  EMAIL
  PHONE
  HANDLE
  DEVICE_ID
  PLATE
  TAIL_NUMBER
  ICAO_HEX
  MMSI
  IMO
  HASH
  DOCUMENT_NO
  NAME
  ADDRESS
  DOMAIN
  IP
  URL
}

/// An identifier extracted from one observation. Raw and normalized both
/// kept, with the normalizer version, so a normalizer change re-resolves only
/// what it touched.
model Identifier {
  id                   String         @id @default(cuid())
  observationId        String
  observation          Observation    @relation(fields: [observationId], references: [id], onDelete: Cascade)
  kind                 IdentifierKind
  value                String
  normalizedValue      String
  normalizationVersion String

  @@index([observationId])
  @@index([kind, normalizedValue])
}

enum FusionEntityKind {
  PERSON
  ORG
  VESSEL
  AIRCRAFT
  VEHICLE
  ACCOUNT
  LOCATION
  DEVICE
  INFRASTRUCTURE
}

enum EntityStatus {
  RESOLVED
  PROVISIONAL
  UNRESOLVED
  DISPUTED
}

/// The resolved cluster. Separate from the v1 case graph on purpose: that
/// graph is recomputed from findings on every read and stays that way. This
/// is persisted because a resolution run is expensive and its decisions are
/// evidence.
model Entity {
  id              String           @id @default(cuid())
  kind            FusionEntityKind
  canonicalLabel  String
  status          EntityStatus     @default(PROVISIONAL)
  createdAt       DateTime         @default(now())
  lastResolvedAt  DateTime?
  resolutionRunId String?
  resolutionRun   ResolutionRun?   @relation(fields: [resolutionRunId], references: [id], onDelete: SetNull)

  members     EntityMember[]
  edgesFrom   EntityEdge[]       @relation("EdgeFrom")
  edgesTo     EntityEdge[]       @relation("EdgeTo")
  enrollments GalleryEnrollment[]

  @@index([kind, status])
  @@index([resolutionRunId])
}

enum MemberAddedBy {
  SYSTEM
  ANALYST
}

/// Observation-to-entity membership. Never deleted (trigger). Superseded
/// instead, so an observation's whole membership history stays readable.
model EntityMember {
  id            String        @id @default(cuid())
  entityId      String
  entity        Entity        @relation(fields: [entityId], references: [id])
  observationId String
  observation   Observation   @relation(fields: [observationId], references: [id])
  scoreBp       Int
  method        String
  addedAt       DateTime      @default(now())
  addedBy       MemberAddedBy
  addedByActor  String        @default("system")
  supersededAt  DateTime?
  supersededBy  String?

  @@index([entityId, supersededAt])
  @@index([observationId])
}

enum RunStatus {
  RUNNING
  COMPLETE
  FAILED
}

model ResolutionRun {
  id                   String        @id @default(cuid())
  authorizationId      String
  authorization        Authorization @relation(fields: [authorizationId], references: [id])
  status               RunStatus     @default(RUNNING)
  startedAt            DateTime      @default(now())
  finishedAt           DateTime?
  modelVersion         String
  normalizationVersion String
  matchThresholdBp     Int
  reviewThresholdBp    Int
  pairsEvaluated       Int           @default(0)
  triggeredBy          String        @default("local")
  errorMessage         String?

  entities  Entity[]
  decisions MatchDecision[]

  @@index([authorizationId, startedAt])
}

enum MatchOutcome {
  MATCH
  NON_MATCH
  REVIEW
  INDETERMINATE
}

/// Every pair evaluated, matches and non-matches alike. Immutable (trigger).
/// This table is the product's defensibility: what was compared, on which
/// blocking key, with which model, and what it scored.
model MatchDecision {
  id                 String        @id @default(cuid())
  runId              String
  run                ResolutionRun @relation(fields: [runId], references: [id])
  leftObservationId  String
  rightObservationId String
  scoreBp            Int?
  decision           MatchOutcome
  featureVector      Json
  modelVersion       String
  blockingKey        String
  createdAt          DateTime      @default(now())

  @@unique([runId, leftObservationId, rightObservationId])
  @@index([decision, createdAt])
  @@index([leftObservationId])
  @@index([rightObservationId])
}

/// A human's call on a pair. Its own table, keyed by the unordered pair, so
/// the resolver can read it before scoring: a pinned decision outranks the
/// model on every re-run. Append-only; the newest row for a pair wins.
model Adjudication {
  id                 String       @id @default(cuid())
  /// `min(id)|max(id)` of the two observations.
  pairKey            String
  leftObservationId  String
  rightObservationId String
  decision           MatchOutcome
  adjudicatedBy      String
  note               String
  createdAt          DateTime     @default(now())

  @@index([pairKey, createdAt])
}

enum EdgeRelation {
  CO_LOCATED
  COMMUNICATED_WITH
  OWNS
  OPERATES
  MEMBER_OF
  TRANSACTED_WITH
  SAME_DEVICE
  ASSOCIATED_WITH
}

/// The temporal graph. Two clocks: validFrom/validUntil is when the
/// relationship held; createdAt/supersededAt is when Scout knew it. A query
/// at asOf = T applies both (packages/fusion/src/temporal.ts). Never deleted
/// (trigger); superseded instead.
model EntityEdge {
  id                     String        @id @default(cuid())
  fromEntityId           String
  from                   Entity        @relation("EdgeFrom", fields: [fromEntityId], references: [id])
  toEntityId             String
  to                     Entity        @relation("EdgeTo", fields: [toEntityId], references: [id])
  relation               EdgeRelation
  validFrom              DateTime
  validUntil             DateTime?
  confidenceBp           Int
  /// Never empty. Enforced in the write path; a check constraint backs it.
  evidenceObservationIds String[]
  /// How the edge was derived, machine-readable: `co-location:2000m/30min`,
  /// `shared:PHONE`, `shared:DEVICE_ID`, or `asserted` for an analyst's own.
  basis                  String        @default("asserted")
  /// Identity of a derived edge across runs: from, to, relation, basis,
  /// window and evidence. A re-derivation that produces the same fingerprint
  /// keeps the row; one that does not supersedes it.
  fingerprint            String?
  authorizationId        String
  authorization          Authorization @relation(fields: [authorizationId], references: [id])
  createdAt              DateTime      @default(now())
  createdBy              String        @default("system")
  supersededAt           DateTime?
  supersededBy           String?

  @@index([fromEntityId, validFrom])
  @@index([toEntityId, validFrom])
  @@index([authorizationId, supersededAt])
  @@index([authorizationId, fingerprint])
  @@index([createdAt])
}

// ── biometrics: gallery-restricted ────────────────────────────────────────

enum LawfulBasis {
  CONSENT
  COURT_ORDER
  STATUTORY_AUTHORITY
  EMPLOYMENT
  CONTRACT
}

/// A named set of enrolled identities with one recorded lawful basis. The
/// only thing a probe can be compared against.
model Gallery {
  id                     String      @id @default(cuid())
  name                   String
  purpose                String
  custodianOrg           String
  lawfulBasis            LawfulBasis
  lawfulBasisDocumentRef String
  reviewDueAt            DateTime
  createdAt              DateTime    @default(now())
  createdBy              String      @default("local")

  enrollments GalleryEnrollment[]
  comparisons BiometricComparison[]

  @@index([reviewDueAt])
}

enum Modality {
  FACE
  VOICE
}

/// An encrypted embedding. `templateRef` on an enrollment points here. The
/// media it was made from is not stored anywhere; only its hash is, in the
/// audit event of the enrollment. AES-256-GCM under RECOGNITION_TEMPLATE_KEY.
model BiometricTemplate {
  id         String   @id @default(cuid())
  galleryId  String
  modality   Modality
  dims       Int
  model      String
  ciphertext Bytes
  iv         Bytes
  tag        Bytes
  /// Identifies which key encrypted it, for rotation. Never the key.
  keyId      String
  createdAt  DateTime @default(now())

  @@index([galleryId, modality])
}

/// One identity's template in one gallery. `templateRef` points at the
/// encrypted embedding store; the media it came from is never stored beside
/// it. Expires; re-review is required.
model GalleryEnrollment {
  id                     String   @id @default(cuid())
  galleryId              String
  gallery                Gallery  @relation(fields: [galleryId], references: [id])
  entityId               String
  entity                 Entity   @relation(fields: [entityId], references: [id])
  modality               Modality
  templateRef            String
  enrolledAt             DateTime @default(now())
  enrolledBy             String
  lawfulBasisDocumentRef String
  expiresAt              DateTime
  revokedAt              DateTime?

  @@index([galleryId, modality, expiresAt])
  @@index([entityId])
}

enum ComparisonDecision {
  MATCH
  NO_MATCH
  INDETERMINATE
}

/// Every comparison, whether or not it matched. Immutable (trigger).
model BiometricComparison {
  id              String             @id @default(cuid())
  probeHash       String
  galleryId       String
  gallery         Gallery            @relation(fields: [galleryId], references: [id])
  authorizationId String
  authorization   Authorization      @relation(fields: [authorizationId], references: [id])
  modality        Modality
  /// `[{ enrollmentId, distanceBp }]`, best first.
  topMatches      Json
  thresholdBp     Int
  decision        ComparisonDecision
  requestedBy     String
  requestedAt     DateTime           @default(now())

  @@index([galleryId, requestedAt])
  @@index([authorizationId, requestedAt])
}

// ── read audit ────────────────────────────────────────────────────────────

/// Every read of the v2 graph. Who, under what authorization, what action,
/// which targets (ids, never payloads), how many came back, when. Same
/// immutability trigger as QueryLog. `AuditEvent` keeps its v1 shape.
/// One stored image of one scene over one box: the tile index the spec asks
/// for. The bytes live in object storage under `objectKey` (GeoTIFF) and
/// `previewKey` (PNG the console can draw); the row is what makes a second
/// request for the same scene and box a lookup rather than a download.
model ImageryTile {
  id              String   @id @default(cuid())
  sourceId        String
  authorizationId String
  caseId          String?
  sceneId         String
  sensedAt        DateTime
  cloudCoverPct   Int?
  /// `west,south,east,north` in degrees, and its hash for the unique key.
  bbox            Float[]
  bboxHash        String
  /// PostGIS geography polygon of the box, for spatial lookup. Written by raw SQL.
  geom            Unsupported("geography(Polygon,4326)")?
  objectKey       String
  previewKey      String?
  bytes           Int
  widthPx         Int
  heightPx        Int
  resolutionM     Int
  format          String
  /// True only when the stored GeoTIFF was written as a Cloud Optimized GeoTIFF.
  cloudOptimized  Boolean  @default(false)
  createdAt       DateTime @default(now())

  /// Per authorization: the row is the access record. The bytes in the bucket
  /// are shared across authorizations (same public scene), the index is not.
  @@unique([sourceId, sceneId, bboxHash, authorizationId])
  @@index([authorizationId, sensedAt])
}

// ── the agentic layer ─────────────────────────────────────────────────────

enum AgentTier {
  OBSERVE
  PREPARE
  CONSEQUENTIAL
}

enum ProposalStatus {
  PROPOSED
  APPROVED
  EXECUTED
  REJECTED
  REFUSED
}

/// What the agent proposes to do: the act, why (with the observations it
/// rests on), the scope it needs and what it would affect. A consequential
/// proposal executes only under a recorded approval.
model AgentProposal {
  id              String         @id @default(cuid())
  caseId          String
  authorizationId String
  kind            String
  tier            AgentTier
  title           String
  rationale       String
  /// Observation ids under the same authorization. Required for anything above observe.
  citations       String[]
  requiresScope   Json
  affects         Json
  params          Json
  status          ProposalStatus @default(PROPOSED)
  proposedBy      String
  createdAt       DateTime       @default(now())
  decidedAt       DateTime?
  decidedBy       String?
  decisionNote    String?
  executedAt      DateTime?
  result          Json?

  approvals AgentApproval[]

  @@index([caseId, status, createdAt])
  @@index([authorizationId])
}

/// One human's approval of one proposal: single-use, expiring, never
/// transferable. `usedAt` is the only field that changes, once.
model AgentApproval {
  id         String        @id @default(cuid())
  proposalId String
  proposal   AgentProposal @relation(fields: [proposalId], references: [id])
  approvedBy String
  approvedAt DateTime      @default(now())
  expiresAt  DateTime
  usedAt     DateTime?
  note       String

  @@index([proposalId, usedAt])
}

enum GraphMonitorKind {
  CO_LOCATION
  NEW_OBSERVATIONS
  MEMBERSHIP_CHANGE
}

/// A standing watch on the entity graph, inside one authorization. It does
/// not outlive that authorization: the sweep disables it the first time
/// the scope context refuses to build.
model GraphMonitor {
  id              String           @id @default(cuid())
  caseId          String
  authorizationId String
  kind            GraphMonitorKind
  name            String
  params          Json
  createdBy       String
  createdAt       DateTime         @default(now())
  disabledAt      DateTime?
  disabledReason  String?
  lastEvaluatedAt DateTime?
  lastState       Json?

  alerts GraphAlert[]

  @@index([caseId, disabledAt])
  @@index([authorizationId])
}

/// What a monitor saw change, with the observations behind it.
model GraphAlert {
  id              String       @id @default(cuid())
  monitorId       String
  monitor         GraphMonitor @relation(fields: [monitorId], references: [id])
  caseId          String
  authorizationId String
  at              DateTime     @default(now())
  summary         String
  detail          Json
  observationIds  String[]
  acknowledgedAt  DateTime?
  acknowledgedBy  String?

  @@index([caseId, at])
  @@index([monitorId, at])
}

model AccessLog {
  id              String   @id @default(cuid())
  actor           String
  authorizationId String?
  action          String
  targetType      String
  targetIds       String[]
  queryText       String?
  resultCount     Int
  createdAt       DateTime @default(now())

  @@index([authorizationId, createdAt])
  @@index([actor, createdAt])
  @@index([targetType, createdAt])
}
