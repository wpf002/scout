{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "next/link": ["./node_modules/next/link.d.ts"],
      "next/navigation": ["./node_modules/next/navigation.d.ts"],
      "@scout/scope": ["../../packages/scope/dist/index.d.ts"],
      "@scout/sources": ["../../packages/sources/dist/index.d.ts"],
      "@scout/graph": ["../../packages/graph/dist/index.d.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "demo/dist"]
}
