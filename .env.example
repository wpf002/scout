# Scout — copy to .env and fill in. Never commit the populated file.

# ── core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# 127.0.0.1 binds IPv4 only, which is deliberate and matched by the dashboard's
# proxy target. Do not change this to `localhost` — Node resolves that to ::1
# first, and a v6 bind with a v4 proxy (or the reverse) makes a healthy API
# look unreachable from the page while it answers fine over curl.
HOST=127.0.0.1
PORT=3001

# Written to every audit row. Replaced by real per-operator auth in Phase 8.
SCOUT_OPERATOR=local

# Treat every subject as authorized, regardless of the investigation's scope.
# For an instance whose operator is authorized for whatever they search. The
# audit log is unaffected — every run is still recorded; this only changes what
# the gate refuses, not what gets written down.
SCOUT_AUTHORIZE_ALL=true

# ── monitor scheduling ──────────────────────────────────────────────────────
# How often the API sweeps for monitors whose interval has elapsed, in seconds.
# UNSET means no ticker at all: without it, a standing watch only runs when
# somebody presses "Run now" or something external calls POST /monitors/run-due.
#
# This is a timer, not a job queue — no retries, no backoff, no persistence
# across a restart. It is safe to leave on: sweeps never overlap, and every
# monitor is claimed with a conditional update before it runs, so this ticker,
# an external cron, and a second API replica can all point at the same database
# without double-running anything.
#
# Monitor intervals are hourly at the fastest, so anything below ~60s only adds
# database round-trips. 300 (five minutes) is a sensible starting point.
SCOUT_MONITOR_TICK_SECONDS=300

# ── web dashboard ───────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser, comma-separated. An
# allowlist, never `*` — this API drives scope-gated lookups.
SCOUT_WEB_ORIGINS=http://localhost:3000

# Where the dashboard finds the API, from the browser's point of view. Baked
# into the client bundle at build time.
#
# LEAVE THIS EMPTY unless you genuinely need the browser calling the API
# directly. Empty means same-origin `/api/…`, which Next rewrites to the API —
# one URL to open and no CORS to keep in sync.
#
# Setting it to the API's own origin does NOT work, and fails in a way that
# looks like the API is down: the client appends `/api` to whatever is here, so
# `http://localhost:3001` produces `http://localhost:3001/api/cases`, and the
# API serves `/cases`. The `/api` prefix exists only as the rewrite's *source*.
# If you do set this, point it at an origin that proxies `/api/*` the same way.
NEXT_PUBLIC_API_URL=

# ── database ────────────────────────────────────────────────────────────────
# 127.0.0.1 rather than `localhost` on purpose. `localhost` resolves to ::1
# first on most machines, and anything else publishing 5432 on IPv6 — a Docker
# container is the usual culprit — will answer instead of the local cluster,
# with an auth failure that reads as "your password is wrong".
DATABASE_URL=postgresql://scout:scout@127.0.0.1:5432/scout?schema=public

# ── scope fallback (keyless local use only) ─────────────────────────────────
# Used ONLY when there is no case in play, and only for planning previews.
# Executing a scoped source always requires a real case with an authorization
# reference — env vars cannot authorize one, because an execution has to land
# in the audit log against a case.
#
# Empty means scoped tiers are OFF. It never means unrestricted.
SCOUT_SCOPE_DOMAINS=
SCOUT_SCOPE_IDENTIFIERS=

# ── scoped sources (person-facing — require case scope + audit) ─────────────
HIBP_API_KEY=
# Optional. Hunter rejects a limit above your plan's cap with a 400 for the
# whole request, so this is unset by default and the plan maximum applies.
HUNTER_RESULT_LIMIT=
HUNTER_API_KEY=

# WhatsMyName has no hosted API — Scout enumerates from the project's public
# site list itself, which means dozens of outbound requests about one named
# person. Set to `true` to enable; it is inert otherwise.
WHATSMYNAME_ENABLED=
# Sites probed per query. Default 40.
WHATSMYNAME_SITE_LIMIT=


# ── infra tier (Phase 3) ────────────────────────────────────────────────────
SHODAN_API_KEY=
CENSYS_API_KEY=
# Free key from https://otx.alienvault.com (register, then Settings → API).
# Anonymous requests are throttled to a 429 on the first call.
OTX_API_KEY=

# ── datasets tier (Phase 4) ─────────────────────────────────────────────────
# The API URL shown on your intelx.io Developer tab. Accounts are assigned
# different instances; a key from one returns 401 against another.
INTELX_BASE_URL=
INTELX_API_KEY=
OPENSANCTIONS_API_KEY=

# ── utils ───────────────────────────────────────────────────────────────────
URLSCAN_API_KEY=


# ==== v2 additions (storage, imagery, resolution, recognition, reasoning, agent) ====
# v2 needs PostGIS; scripts/bootstrap-v2.sh points DATABASE_URL at the Docker
# cluster on 5439 and appends everything below to your .env once.

# ── object storage (S3 API) ─────────────────────────────────────────────────
# Local: MinIO from the compose file. Production: any S3-compatible store
# (Cloudflare R2 is the intended one; Railway has no native S3).
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_MEDIA=scout-media
S3_BUCKET_TILES=scout-tiles
S3_ACCESS_KEY=scout
S3_SECRET_KEY=scout-minio-local
S3_FORCE_PATH_STYLE=true
# Imagery is stored as a Cloud Optimized GeoTIFF when a converter is on PATH:
# gdal_translate (GDAL) or rio (rio-cogeo), auto-detected. Force one with
# gdal_translate or rio. Absent, the plain GeoTIFF is stored and the tile's
# cloudOptimized stays false.
IMAGERY_COG_COMMAND=

# ── resolution service (services/resolution, FastAPI) ──────────────────────
RESOLUTION_SERVICE_URL=http://127.0.0.1:8100
# Thresholds are in basis points of a 0–10000 probability scale, integer only.
# Above MATCH → automatic match. Below REVIEW → automatic non-match. Between →
# queued for a human. The band can never be collapsed: MATCH must exceed REVIEW
# or the API refuses to start (packages/scope prohibitions).
RESOLUTION_MATCH_THRESHOLD=9500
RESOLUTION_REVIEW_THRESHOLD=7000
# Per-kind overrides, same rule: MATCH must exceed REVIEW.
# RESOLUTION_MATCH_THRESHOLD_PERSON=9700
# RESOLUTION_REVIEW_THRESHOLD_PERSON=7500
# Where the trained per-kind Splink models live (services/resolution/models by default).
RESOLUTION_MODEL_DIR=
# A run is refused before scoring when its blocking would propose more pairs
# than this (the service names the rule responsible). Default twenty million.
RESOLUTION_MAX_PAIRS=
# How long one run may take, the service call and the persistence each. Default ten minutes.
RESOLUTION_TIMEOUT_MS=
# Per-column evidence travels with MATCH and REVIEW decisions; "all" keeps it for NON_MATCH too.
RESOLUTION_FEATURES_FOR=match,review

# ── recognition service (services/recognition, gallery-restricted) ─────────
# Off by default and behind a flag. Every comparison needs an active
# authorization, a named gallery with a recorded lawful basis, and a scope
# that permits BIOMETRIC_COMPARE. There is no probe-without-gallery route.
RECOGNITION_ENABLED=false
RECOGNITION_SERVICE_URL=http://127.0.0.1:8200
RECOGNITION_FACE_MODEL=buffalo_l
RECOGNITION_VOICE_MODEL=speechbrain/spkrec-ecapa-voxceleb
RECOGNITION_GALLERY_REQUIRE_LAWFUL_BASIS=true
# Templates are encrypted at rest with this key (64 hex characters = 32 bytes;
# `openssl rand -hex 32`). Media is never stored at all. Without the key,
# enrollment is refused rather than stored in the clear.
RECOGNITION_TEMPLATE_KEY=
# Cosine distance in basis points at or under which the best candidate is a
# match, and the gap to the runner-up under which the answer is INDETERMINATE
# instead. Defaults are starting points; calibrate on the deployment's gallery.
RECOGNITION_FACE_THRESHOLD_BP=6000
RECOGNITION_VOICE_THRESHOLD_BP=7500
RECOGNITION_MARGIN_BP=500
# Tests only: RECOGNITION_EMBEDDER=test selects a deterministic hash-based
# embedder in the service. It is not a recogniser. Leave unset in any real use.
RECOGNITION_EMBEDDER=

# ── collection connectors ──────────────────────────────────────────────────
# Each connector states its licence in docs/SOURCES.md and in code; a
# connector without licensing terms refuses to register.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
AISSTREAM_API_KEY=
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=
# Defaults target the Copernicus Data Space Ecosystem (the free tier). Override
# both for a legacy Sentinel Hub or enterprise account.
SENTINELHUB_BASE_URL=
SENTINELHUB_TOKEN_URL=
# SEC EDGAR asks every client to declare who it is. Public domain data, but the
# collector is inert until this is set; Scout will not invent a contact.
# Example: Scout (Your Org) contact@your.org
SEC_EDGAR_USER_AGENT=

# ── reasoning layer ────────────────────────────────────────────────────────
# Scout's own model seam (packages/reason, Phase 8). No vendor SDK is called
# outside it. Provider is one of: anthropic | openai | ollama | none.
REASON_PROVIDER=none
REASON_MODEL_PLANNER=
REASON_MODEL_SYNTHESIS=
REASON_API_KEY=
# Optional. An OpenAI-compatible endpoint, or an Ollama host. Defaults per provider.
REASON_BASE_URL=

# ── agentic layer ──────────────────────────────────────────────────────────
# observe | prepare. "consequential" is refused at startup; it is not a
# permitted value for this variable and never will be.
AGENT_MAX_AUTONOMOUS_TIER=observe
# Where proposals that need a person are posted (JSON), if anywhere.
AGENT_APPROVAL_WEBHOOK=
# Where an approved send-report delivers (JSON with the stored report's key).
# Unset means a send-report proposal is refused before its approval is spent.
AGENT_DELIVERY_WEBHOOK=
# The agent's observe pass on a timer, in seconds (at least 5). Unset: on
# demand only, via POST /v2/agent/tick.
SCOUT_AGENT_TICK_SECONDS=
