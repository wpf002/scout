# Scout — copy to .env and fill in. Never commit the populated file.

# ── core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# 127.0.0.1 binds IPv4 only, which is deliberate and matched by the dashboard's
# proxy target. Do not change this to `localhost` — Node resolves that to ::1
# first, and a v6 bind with a v4 proxy (or the reverse) makes a healthy API
# look unreachable from the page while it answers fine over curl.
HOST=127.0.0.1
PORT=3001

# Written to every audit row. Replaced by real per-operator auth in Phase 8.
SCOUT_OPERATOR=local

# Treat every subject as authorized, regardless of the investigation's scope.
# For an instance whose operator is authorized for whatever they search. The
# audit log is unaffected — every run is still recorded; this only changes what
# the gate refuses, not what gets written down.
SCOUT_AUTHORIZE_ALL=true

# ── monitor scheduling ──────────────────────────────────────────────────────
# How often the API sweeps for monitors whose interval has elapsed, in seconds.
# UNSET means no ticker at all: without it, a standing watch only runs when
# somebody presses "Run now" or something external calls POST /monitors/run-due.
#
# This is a timer, not a job queue — no retries, no backoff, no persistence
# across a restart. It is safe to leave on: sweeps never overlap, and every
# monitor is claimed with a conditional update before it runs, so this ticker,
# an external cron, and a second API replica can all point at the same database
# without double-running anything.
#
# Monitor intervals are hourly at the fastest, so anything below ~60s only adds
# database round-trips. 300 (five minutes) is a sensible starting point.
# SCOUT_MONITOR_TICK_SECONDS=300

# ── web dashboard ───────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser, comma-separated. An
# allowlist, never `*` — this API drives scope-gated lookups.
SCOUT_WEB_ORIGINS=http://localhost:3000

# Where the dashboard finds the API, from the browser's point of view. Baked
# into the client bundle at build time.
#
# LEAVE THIS EMPTY unless you genuinely need the browser calling the API
# directly. Empty means same-origin `/api/…`, which Next rewrites to the API —
# one URL to open and no CORS to keep in sync.
#
# Setting it to the API's own origin does NOT work, and fails in a way that
# looks like the API is down: the client appends `/api` to whatever is here, so
# `http://localhost:3001` produces `http://localhost:3001/api/cases`, and the
# API serves `/cases`. The `/api` prefix exists only as the rewrite's *source*.
# If you do set this, point it at an origin that proxies `/api/*` the same way.
NEXT_PUBLIC_API_URL=

# ── database ────────────────────────────────────────────────────────────────
# 127.0.0.1 rather than `localhost` on purpose. `localhost` resolves to ::1
# first on most machines, and anything else publishing 5432 on IPv6 — a Docker
# container is the usual culprit — will answer instead of the local cluster,
# with an auth failure that reads as "your password is wrong".
DATABASE_URL=postgresql://scout:scout@127.0.0.1:5432/scout?schema=public

# ── scope fallback (keyless local use only) ─────────────────────────────────
# Used ONLY when there is no case in play, and only for planning previews.
# Executing a scoped source always requires a real case with an authorization
# reference — env vars cannot authorize one, because an execution has to land
# in the audit log against a case.
#
# Empty means scoped tiers are OFF. It never means unrestricted.
SCOUT_SCOPE_DOMAINS=
SCOUT_SCOPE_IDENTIFIERS=

# ── scoped sources (person-facing — require case scope + audit) ─────────────
HIBP_API_KEY=
DEHASHED_API_KEY=
HUNTER_API_KEY=

# WhatsMyName has no hosted API — Scout enumerates from the project's public
# site list itself, which means dozens of outbound requests about one named
# person. Set to `true` to enable; it is inert otherwise.
WHATSMYNAME_ENABLED=
# Sites probed per query. Default 40.
WHATSMYNAME_SITE_LIMIT=

# DeHashed returns credential material. Scout redacts it by default and
# reports only that a password exists, because a case database should not
# become a credential store. Set to `true` only if the engagement genuinely
# requires the material (credential-stuffing validation).
SCOUT_ALLOW_CREDENTIAL_MATERIAL=

# ── infra tier (Phase 3) ────────────────────────────────────────────────────
SHODAN_API_KEY=
CENSYS_API_KEY=
SECURITYTRAILS_API_KEY=

# ── datasets tier (Phase 4) ─────────────────────────────────────────────────
INTELX_API_KEY=
OPENSANCTIONS_API_KEY=
# Free account at https://aleph.occrp.org — the API rejects even public
# collection queries without one.
ALEPH_API_KEY=

# ── utils ───────────────────────────────────────────────────────────────────
URLSCAN_API_KEY=
